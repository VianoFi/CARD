@model CARD.Models.DemoHelperTagsViewModel
@{
    ViewData["Title"] = "Demo Helper Tags";
}

<div class="container mt-5">
    <h1 class="text-center mb-5">🎓 Dimostrazione Helper Tags</h1>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    }

   
    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white">
            <h3>📝 Form Completo Funzionante</h3>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Demo" asp-action="HelperTag" method="post">

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Es: Mario Rossi" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Paese" class="form-label"></label>
                    <select asp-for="Paese" class="form-select">
                        <option value="">-- Seleziona un paese --</option>
                        <option value="IT">Italia</option>
                        <option value="FR">Francia</option>
                        <option value="DE">Germania</option>
                        <option value="ES">Spagna</option>
                        <option value="UK">Regno Unito</option>
                    </select>
                    <span asp-validation-for="Paese" class="text-danger"></span>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        Invia Dati
                    </button>
                </div>

                <div asp-validation-summary="All" class="text-danger mt-3"></div>
            </form>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            ← Torna alla Home
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}