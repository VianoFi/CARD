@model CARD.Models.UploadViewModel
@{
    ViewData["Title"] = "Caricamento File";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Carica file: .jpg, .jpeg, .gif, .pdf (max 3MB ciascuno)</p>

    <form method="post" enctype="multipart/form-data" class="border p-4 rounded bg-light">
        <div class="mb-3">
            <label for="fileInput" class="form-label fw-bold">Seleziona file:</label>
            <input type="file"
                   name="Files"
                   id="fileInput"
                   multiple
                   class="form-control"
                   accept=".jpg,.jpeg,.gif,.pdf"
                   required />
            <small class="form-text text-muted">Puoi selezionare più file.</small>
        </div>

        <button type="submit" class="btn btn-primary">Carica File</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-info mt-4">
            @Model.SuccessMessage
        </div>
    }

    @if (Model.Errors != null && Model.Errors.Any())
    {
        <div class="alert alert-danger mt-4">
            <h5>Errori:</h5>
            <ul class="mb-0">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
</div>